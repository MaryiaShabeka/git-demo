        },
        {
            "id": "265075",
            "type": "html",
            "data": {
                "html": "<script type=\"text/ytmscript\">\n  if (!sessionStorage.getItem('two_minutes_tracked')) {\n    setTimeout(function () {\n      window.dataLayer = window.dataLayer || [];\n      dataLayer.push({\n        event: 'two_minutes_on_page'\n      });\n      sessionStorage.setItem('two_minutes_tracked', '1');\n    }, 120000); // 2 минуты = 120000 мс\n  }\n</script>"
            },
