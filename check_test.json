        {
            "id": "1178445",
            "type": "html",
            "data": {
                "html": "<script type=\"text/ytmscript\">\n(function(){\n  if (window.__dlEnrichInstalled) return;\n  window.__dlEnrichInstalled = true;\n\n  // Все селекторы, внутри которых может быть ссылка с utm_creative\n  var SELECTORS = [\n    'a[class*=\"-type-banner\"]',\n    '.b-colored *',\n    '.pr-b-content-wrp *',\n    '.pr-wrp *'\n  ];\n\n  // Оригинальный push\n  window.dataLayer = window.dataLayer || [];\n  var _push = window.dataLayer.push;\n\n  // Проверка видимости (≥50% высоты в вьюпорте)\n  function inView(el){\n    try{\n      var r = el.getBoundingClientRect();\n      var h = r.height || (el.offsetHeight || 1);\n      var visible = Math.max(0, Math.min(r.bottom, window.innerHeight) - Math.max(r.top, 0));\n      return (visible / h) >= 0.5;\n    }catch(e){ return false; }\n  }\n\n  // Находим первый видимый элемент по набору селекторов\n  function findVisibleElement(){\n    try{\n      for (var s = 0; s < SELECTORS.length; s++) {\n        var list = document.querySelectorAll(SELECTORS[s]);\n        for (var i = 0; i < list.length; i++){\n          if (inView(list[i])) return list[i];\n        }\n      }\n    }catch(e){}\n    return null;\n  }\n\n  // Достаём href\n  function getHref(el){\n    try{\n      if (!el) return '';\n      var a = el.querySelector ? el.querySelector('a[href]') : null;\n      if (a && a.getAttribute) return a.getAttribute('href') || '';\n      if (el.tagName && el.tagName.toLowerCase() === 'a') return el.getAttribute('href') || '';\n      if (el.getAttribute){\n        var h = el.getAttribute('data-href') || el.getAttribute('data-url') || '';\n        if (h) return h;\n      }\n      if (el.dataset){\n        var h2 = el.dataset.href || el.dataset.url || '';\n        if (h2) return h2;\n      }\n    }catch(e){}\n    return '';\n  }\n\n  // Парсим creative из href\n  function getCreative(href){\n    try{\n      if (!href) return '';\n      var url = href.indexOf('http') === 0 ? new URL(href) : new URL(href, location.origin);\n      var qs  = new URLSearchParams(url.search);\n      return qs.get('creative') || '';\n    }catch(e){ return ''; }\n  }\n\n  // Перехватываем push и добавляем creative_view\n  window.dataLayer.push = function(obj){\n    try{\n      if (obj && typeof obj === 'object' && obj.event){\n        var ev = String(obj.event);\n        if (ev === 'banner_visible' || ev === 'mini_banner_visible'){\n          if (!obj.hasOwnProperty('creative_view') || !obj.creative_view){\n            var el = findVisibleElement();\n            var href = getHref(el);\n            var creative = getCreative(href);\n            if (creative) {\n              obj.creative_view = creative;\n              window.__ytmCreativeView = creative; // на случай, если используешь через JS-переменную\n            }\n          }\n        }\n      }\n    }catch(e){}\n    return _push.apply(this, arguments);\n  };\n})();\n</script>"
            },
            "permissions": 4
        },
