            "id": "1173171",
            "type": "html",
            "data": {
                "html": [
                    "template",
                    "<script type=\"text/ytmscript\">\n(function(){\n  try{\n    var el = ",
                    [
                        "escape",
                        [
                            "var",
                            6
                        ],
                        7
                    ],
                    ";\n    if (!el) return;\n\n    // ищем URL в ближайшей/вложенной ссылке или на самом элементе\n    var href = '';\n    var a = el.closest ? el.closest('a') : null;\n    if (a && a.getAttribute) href = a.getAttribute('href') || '';\n    if (!href && el.querySelector) {\n      var inside = el.querySelector('a[href]');\n      if (inside) href = inside.getAttribute('href') || '';\n    }\n    if (!href && el.getAttribute) {\n      href = el.getAttribute('href') || el.getAttribute('data-href') || el.getAttribute('data-url') || '';\n    }\n    if (!href && el.dataset) {\n      href = el.dataset.href || el.dataset.url || '';\n    }\n    if (!href) return;\n\n    // парсим параметр creative\n    var url = href.indexOf('http')===0 ? new URL(href) : new URL(href, location.origin);\n    var qs  = new URLSearchParams(url.search);\n    var creative = qs.get('creative');\n\n    // записываем только если есть значение (не затираем пустотой)\n    if (creative) window.__ytmCreative = creative;\n  }catch(e){}\n})();\n</script>"
                ]
            },
